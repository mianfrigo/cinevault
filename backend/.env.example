# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cinevault:cinevault@localhost:5432/cinevault
REDIS_URL=redis://localhost:6379
# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api)
TMDB_READ_TOKEN=replace-me
TMDB_BASE_URL=https://api.themoviedb.org/3
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
WEB_ORIGIN=http://localhost:4200
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false
MAIL_FROM="Cinevault <no-reply@cinevault.local>"
SMTP_URL=smtp://localhost:1025
FEATURE_DOWNLOAD_BUTTON=false
THROTTLE_DISABLED=false
# Set true behind a reverse proxy so req.ip is the client address
TRUST_PROXY=false
# Used only by the seed script (added in a later task)
SEED_ADMIN_EMAIL=admin@cinevault.local
SEED_ADMIN_PASSWORD=replace-me-min-10-chars
