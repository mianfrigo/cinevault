# Copy to .env (gitignored). Variables already set in the shell win.

# PrimeNG license key (primeng.org). Validated in the browser, so it reaches the browser; never commit it.
PRIMENG_LICENSE_KEY=

# Hosts the SSR server answers to (comma separated). Required by the built server.
# NG_ALLOWED_HOSTS=localhost

# Canonical public URL, used for canonical links and og:url. Set it in production.
# SITE_URL=http://localhost:4200

# Where the SSR server reaches the API.
# API_INTERNAL_URL=http://localhost:3000
