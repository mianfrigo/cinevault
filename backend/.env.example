# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cinevault:cinevault@localhost:5432/cinevault
REDIS_URL=redis://localhost:6379
# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api)
TMDB_READ_TOKEN=replace-me
TMDB_BASE_URL=https://api.themoviedb.org/3
# At least 32 random characters (enforced when NODE_ENV=production), e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
WEB_ORIGIN=http://localhost:4200
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false
MAIL_FROM="Cinevault <no-reply@cinevault.local>"
SMTP_URL=smtp://localhost:1025
FEATURE_DOWNLOAD_BUTTON=false
# Tests only. Never true in production.
THROTTLE_DISABLED=false
# Express `trust proxy`, used for the client IP behind rate limiting. false (default) = ignore
# X-Forwarded-For. Behind ONE reverse proxy set 1 (the number of proxies in front of the API).
# Avoid `true`: it trusts the whole header, so a client can fake its IP and dodge the limits.
TRUST_PROXY=false
# Used only by `npm run db:seed` (creates or promotes this admin; keeps the password of an already verified account)
SEED_ADMIN_EMAIL=admin@cinevault.local
SEED_ADMIN_PASSWORD=replace-me-min-10-chars
